{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/work/layout,_N_T_/work/[slug]/layout,_N_T_/work/[slug]/page,_N_T_/work/bt-business-billing"}},"html":"<!DOCTYPE html><!--3_YsJYZWrodYXcBUxiXYU--><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/0081af9fd4fec0e1.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/77601ebe1fbe3da2.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-5c5613942f47120d.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-3d881dfa8c72bc56.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-60b53674f5a8114a.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-6a8cee1febeac4c4.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/874-1ba6df67fefa8f44.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/work/%5Bslug%5D/page-0cf8da57f2058038.js\" async=\"\"></script><title>Anupam Sarkar — Designing where AI is the material</title><meta name=\"description\" content=\"Portfolio of Anupam Sarkar. Senior product designer building AI-native products. The interface is the agent.\"/><meta property=\"og:title\" content=\"Anupam Sarkar — AI-native product design\"/><meta property=\"og:description\" content=\"The interface is the agent. Twelve years of work.\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"Anupam Sarkar — AI-native product design\"/><meta name=\"twitter:description\" content=\"The interface is the agent. Twelve years of work.\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><canvas aria-hidden=\"true\" style=\"position:fixed;inset:0;z-index:0;pointer-events:none;mix-blend-mode:screen\"></canvas><div class=\"grid-overlay\" aria-hidden=\"true\"></div><nav class=\"Nav_nav__o8sSc\" aria-label=\"Primary\"><div class=\"container\"><div class=\"Nav_row__TbWky\"><a class=\"Nav_brand__vMusG\" href=\"/\"><span class=\"Nav_dot__Z8Jyv\" aria-hidden=\"true\"></span><span class=\"Nav_brandText__Rf0lb\">Anupam <span class=\"serif-italic\">Sarkar</span></span></a><div class=\"Nav_links__8Axcs\"><a class=\"Nav_link__AQMuy\" href=\"/\">Work</a><a class=\"Nav_link__AQMuy\" href=\"/frameworks\">Frameworks</a><a class=\"Nav_link__AQMuy\" href=\"/about\">About</a><a class=\"Nav_linkAccent__UnO49\" href=\"/contact\">Contact ↗</a></div></div></div></nav><aside class=\"CaseStudySpine_spine__BrrZ0\" aria-label=\"Case study progress\"><div class=\"CaseStudySpine_label__rSQSU\">case · layers</div><ol class=\"CaseStudySpine_list__U1Qd_\"><li class=\"CaseStudySpine_layer__K0HZ9 CaseStudySpine_active__dgh9M\"><a href=\"#hero\"><span class=\"CaseStudySpine_dot__FJ3V7\" aria-hidden=\"true\"></span><span class=\"CaseStudySpine_num__Rd7nc\">0<!-- -->1</span><span class=\"CaseStudySpine_layerLabel__tAJKA\">Hero</span></a></li><li class=\"CaseStudySpine_layer__K0HZ9 \"><a href=\"#middle\"><span class=\"CaseStudySpine_dot__FJ3V7\" aria-hidden=\"true\"></span><span class=\"CaseStudySpine_num__Rd7nc\">0<!-- -->2</span><span class=\"CaseStudySpine_layerLabel__tAJKA\">Middle</span></a></li><li class=\"CaseStudySpine_layer__K0HZ9 \"><a href=\"#depth\"><span class=\"CaseStudySpine_dot__FJ3V7\" aria-hidden=\"true\"></span><span class=\"CaseStudySpine_num__Rd7nc\">0<!-- -->3</span><span class=\"CaseStudySpine_layerLabel__tAJKA\">Depth</span></a></li></ol></aside><main><section id=\"hero\" class=\"page_hero__Z_1YN\"><div class=\"container\"><div class=\"page_heroMeta__kmrSv\"><span class=\"page_tag__El_eL\">Consumer · billing</span><span>·</span><span>2023</span></div><h1 class=\"page_title__qmGz_\">BT Business — billing that <em>explains</em> itself</h1><p class=\"page_intro__AQqV8\">I led the redesign of the BT Business billing experience for 1.2 million small- and mid-business accounts. Replaced a 14-page PDF invoice with a single living statement that answers the next question before the customer asks it. Shipped under a UK regulator&#x27;s compliance constraint; reduced billing-related support contact by 38%.</p><div class=\"page_heroArtifact__9W71l\"><div class=\"CaseArtifacts_frame__F_BST\"><div class=\"CaseArtifacts_svg__Gz73o\"><svg viewBox=\"0 0 200 120\" width=\"100%\" height=\"100%\" aria-hidden=\"true\"><defs><linearGradient id=\"bet-g\" x1=\"0\" y1=\"0.5\" x2=\"1\" y2=\"0.5\"><stop offset=\"0%\" stop-color=\"#7dffce\" stop-opacity=\"0.1\"></stop><stop offset=\"100%\" stop-color=\"#7dffce\" stop-opacity=\"0.9\"></stop></linearGradient></defs><line x1=\"20\" y1=\"60\" x2=\"160\" y2=\"60\" stroke=\"#3a4156\" stroke-dasharray=\"2 4\"></line><path d=\"M 20 60 L 160 60 L 150 50 M 160 60 L 150 70\" stroke=\"url(#bet-g)\" stroke-width=\"2\" fill=\"none\"></path><circle cx=\"20\" cy=\"60\" r=\"4\" fill=\"#7dffce\" opacity=\"0.4\"></circle><circle cx=\"160\" cy=\"60\" r=\"6\" fill=\"#7dffce\"></circle><text x=\"20\" y=\"80\" fill=\"#8089a0\" font-size=\"7\" font-family=\"monospace\" letter-spacing=\"1\">today</text><text x=\"135\" y=\"80\" fill=\"#7dffce\" font-size=\"7\" font-family=\"monospace\" letter-spacing=\"1\">the bet</text></svg></div><span class=\"CaseArtifacts_label__Sny3J\">the next-question bet</span></div></div><ul class=\"StatStrip_strip__b94z6\"><li class=\"StatStrip_stat__kPw3h\"><div class=\"StatStrip_value__yvSsr\"><span class=\"serif-italic\">1.2M</span></div><div class=\"StatStrip_label__e15lU\">SMB accounts</div></li><li class=\"StatStrip_stat__kPw3h\"><div class=\"StatStrip_value__yvSsr\"><span class=\"serif-italic\">↓ 38%</span></div><div class=\"StatStrip_label__e15lU\">billing support contact</div></li><li class=\"StatStrip_stat__kPw3h\"><div class=\"StatStrip_value__yvSsr\"><span class=\"serif-italic\">14 → 1</span></div><div class=\"StatStrip_label__e15lU\">pages · invoice surface</div></li><li class=\"StatStrip_stat__kPw3h\"><div class=\"StatStrip_value__yvSsr\"><span class=\"serif-italic\">AA</span></div><div class=\"StatStrip_label__e15lU\">WCAG compliance</div></li></ul></div></section><section id=\"middle\" class=\"page_middle__8TYZs\"><div class=\"container\"><div class=\"page_layerLabel__jlWsQ\">// layer 02 · middle</div><h2 class=\"page_layerTitle__PsrE5\">Six artifacts. <em>Each carries the argument.</em></h2><div class=\"page_cards__4ivId\"><article class=\"ArtifactCard_card___XmVC\"><div class=\"ArtifactCard_tag__IQpsb\"><span class=\"ArtifactCard_kind__cjLTf\">BET</span><span class=\"ArtifactCard_num__jGVwF\">01</span></div><p class=\"ArtifactCard_caption__LNt5_\">If the bill answered the customer&#x27;s next question before they had to call, billing-related support contact would collapse — and SMB owners would stop dreading the email subject line &#x27;your BT invoice.&#x27;</p><div class=\"ArtifactCard_visual__4vrVD\"><div class=\"CaseArtifacts_frame__F_BST\"><div class=\"CaseArtifacts_svg__Gz73o\"><svg viewBox=\"0 0 200 120\" width=\"100%\" height=\"100%\" aria-hidden=\"true\"><defs><linearGradient id=\"bet-g\" x1=\"0\" y1=\"0.5\" x2=\"1\" y2=\"0.5\"><stop offset=\"0%\" stop-color=\"#7dffce\" stop-opacity=\"0.1\"></stop><stop offset=\"100%\" stop-color=\"#7dffce\" stop-opacity=\"0.9\"></stop></linearGradient></defs><line x1=\"20\" y1=\"60\" x2=\"160\" y2=\"60\" stroke=\"#3a4156\" stroke-dasharray=\"2 4\"></line><path d=\"M 20 60 L 160 60 L 150 50 M 160 60 L 150 70\" stroke=\"url(#bet-g)\" stroke-width=\"2\" fill=\"none\"></path><circle cx=\"20\" cy=\"60\" r=\"4\" fill=\"#7dffce\" opacity=\"0.4\"></circle><circle cx=\"160\" cy=\"60\" r=\"6\" fill=\"#7dffce\"></circle><text x=\"20\" y=\"80\" fill=\"#8089a0\" font-size=\"7\" font-family=\"monospace\" letter-spacing=\"1\">today</text><text x=\"135\" y=\"80\" fill=\"#7dffce\" font-size=\"7\" font-family=\"monospace\" letter-spacing=\"1\">the bet</text></svg></div><span class=\"CaseArtifacts_label__Sny3J\">the next-question bet</span></div></div></article><article class=\"ArtifactCard_card___XmVC\"><div class=\"ArtifactCard_tag__IQpsb\"><span class=\"ArtifactCard_kind__cjLTf\">ALT</span><span class=\"ArtifactCard_num__jGVwF\">02</span></div><p class=\"ArtifactCard_caption__LNt5_\">Three alternatives rejected: a redesigned PDF, a chatbot-on-top, and a full self-service portal split. Each preserved the underlying anxiety. The chosen path collapsed the invoice into a statement.</p><div class=\"ArtifactCard_visual__4vrVD\"><div class=\"CaseArtifacts_frame__F_BST\"><div class=\"CaseArtifacts_svg__Gz73o\"><svg viewBox=\"0 0 200 120\" width=\"100%\" height=\"100%\" aria-hidden=\"true\"><g transform=\"translate(20, 20)\"><rect width=\"160\" height=\"20\" fill=\"none\" stroke=\"#3a4156\" stroke-dasharray=\"2 3\"></rect><line x1=\"0\" y1=\"10\" x2=\"160\" y2=\"10\" stroke=\"#ff4d8b\" stroke-opacity=\"0.6\" stroke-width=\"1\"></line><text x=\"8\" y=\"14\" fill=\"#8089a0\" font-size=\"7\" font-family=\"monospace\">alt 0<!-- -->1<!-- --> — rejected</text></g><g transform=\"translate(20, 50)\"><rect width=\"160\" height=\"20\" fill=\"none\" stroke=\"#3a4156\" stroke-dasharray=\"2 3\"></rect><line x1=\"0\" y1=\"10\" x2=\"160\" y2=\"10\" stroke=\"#ff4d8b\" stroke-opacity=\"0.6\" stroke-width=\"1\"></line><text x=\"8\" y=\"14\" fill=\"#8089a0\" font-size=\"7\" font-family=\"monospace\">alt 0<!-- -->2<!-- --> — rejected</text></g><g transform=\"translate(20, 80)\"><rect width=\"160\" height=\"20\" fill=\"none\" stroke=\"#3a4156\" stroke-dasharray=\"2 3\"></rect><line x1=\"0\" y1=\"10\" x2=\"160\" y2=\"10\" stroke=\"#ff4d8b\" stroke-opacity=\"0.6\" stroke-width=\"1\"></line><text x=\"8\" y=\"14\" fill=\"#8089a0\" font-size=\"7\" font-family=\"monospace\">alt 0<!-- -->3<!-- --> — rejected</text></g></svg></div><span class=\"CaseArtifacts_label__Sny3J\">three rejected paths</span></div></div></article><article class=\"ArtifactCard_card___XmVC\"><div class=\"ArtifactCard_tag__IQpsb\"><span class=\"ArtifactCard_kind__cjLTf\">CONSTRAINT</span><span class=\"ArtifactCard_num__jGVwF\">03</span></div><p class=\"ArtifactCard_caption__LNt5_\">UK Ofcom rules dictate what must appear on a B2B bill. The redesign had to honour every regulatory line item — and still feel like a single readable document, not a compliance dump.</p><div class=\"ArtifactCard_visual__4vrVD\"><div class=\"CaseArtifacts_frame__F_BST\"><div class=\"CaseArtifacts_svg__Gz73o\"><svg viewBox=\"0 0 200 120\" width=\"100%\" height=\"100%\" aria-hidden=\"true\"><rect x=\"40\" y=\"20\" width=\"120\" height=\"80\" fill=\"none\" stroke=\"#7dffce\" stroke-opacity=\"0.4\"></rect><rect x=\"60\" y=\"40\" width=\"80\" height=\"40\" fill=\"rgba(125,255,206,0.06)\" stroke=\"#7dffce\" stroke-opacity=\"0.8\"></rect><path d=\"M 100 10 l 0 8\" stroke=\"#f5c66b\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><path d=\"M 190 60 l -8 0\" stroke=\"#f5c66b\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><path d=\"M 100 110 l 0 -8\" stroke=\"#f5c66b\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><path d=\"M 10 60 l 8 0\" stroke=\"#f5c66b\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><defs><marker id=\"arrow\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\"><path d=\"M0,0 L6,3 L0,6 z\" fill=\"#f5c66b\"></path></marker></defs><text x=\"100\" y=\"64\" fill=\"#7dffce\" font-size=\"8\" font-family=\"monospace\" text-anchor=\"middle\">surface</text></svg></div><span class=\"CaseArtifacts_label__Sny3J\">the ofcom constraint</span></div></div></article><article class=\"ArtifactCard_card___XmVC\"><div class=\"ArtifactCard_tag__IQpsb\"><span class=\"ArtifactCard_kind__cjLTf\">SYSTEM</span><span class=\"ArtifactCard_num__jGVwF\">04</span></div><p class=\"ArtifactCard_caption__LNt5_\">A statement engine that takes 14 source PDF sections and renders them as one progressive HTML document — each section collapsing into a summary line, expanding only when the customer asks.</p><div class=\"ArtifactCard_visual__4vrVD\"><div class=\"CaseArtifacts_frame__F_BST\"><div class=\"CaseArtifacts_svg__Gz73o\"><svg viewBox=\"0 0 200 120\" width=\"100%\" height=\"100%\" aria-hidden=\"true\"><g><line x1=\"48\" y1=\"60\" x2=\"79\" y2=\"60\" stroke=\"#00d4ff\" stroke-opacity=\"0.6\"></line><circle cx=\"40\" cy=\"60\" r=\"8\" fill=\"rgba(0,212,255,0.15)\" stroke=\"#7dffce\"></circle><text x=\"40\" y=\"86\" fill=\"#8089a0\" font-size=\"7\" font-family=\"monospace\" text-anchor=\"middle\" letter-spacing=\"1\">sense</text></g><g><line x1=\"95\" y1=\"60\" x2=\"125\" y2=\"60\" stroke=\"#00d4ff\" stroke-opacity=\"0.6\"></line><circle cx=\"87\" cy=\"60\" r=\"8\" fill=\"rgba(0,212,255,0.15)\" stroke=\"#7dffce\"></circle><text x=\"87\" y=\"86\" fill=\"#8089a0\" font-size=\"7\" font-family=\"monospace\" text-anchor=\"middle\" letter-spacing=\"1\">morph</text></g><g><line x1=\"141\" y1=\"60\" x2=\"172\" y2=\"60\" stroke=\"#00d4ff\" stroke-opacity=\"0.6\"></line><circle cx=\"133\" cy=\"60\" r=\"8\" fill=\"rgba(0,212,255,0.15)\" stroke=\"#7dffce\"></circle><text x=\"133\" y=\"86\" fill=\"#8089a0\" font-size=\"7\" font-family=\"monospace\" text-anchor=\"middle\" letter-spacing=\"1\">confirm</text></g><g><circle cx=\"180\" cy=\"60\" r=\"8\" fill=\"rgba(0,212,255,0.15)\" stroke=\"#7dffce\"></circle><text x=\"180\" y=\"86\" fill=\"#8089a0\" font-size=\"7\" font-family=\"monospace\" text-anchor=\"middle\" letter-spacing=\"1\">escape</text></g><text x=\"100\" y=\"30\" fill=\"#7dffce\" font-size=\"8\" font-family=\"monospace\" text-anchor=\"middle\" letter-spacing=\"2\">IFU SPINE</text></svg></div><span class=\"CaseArtifacts_label__Sny3J\">the statement engine</span></div></div></article><article class=\"ArtifactCard_card___XmVC\"><div class=\"ArtifactCard_tag__IQpsb\"><span class=\"ArtifactCard_kind__cjLTf\">ARTIFACT</span><span class=\"ArtifactCard_num__jGVwF\">05</span></div><p class=\"ArtifactCard_caption__LNt5_\">The &#x27;why did this change?&#x27; inline answer — a system that detects month-over-month deltas and pre-writes the explanation in plain English. The number one billing question, answered without asking.</p><div class=\"ArtifactCard_visual__4vrVD\"><div class=\"CaseArtifacts_frame__F_BST\"><div class=\"CaseArtifacts_svg__Gz73o\"><svg viewBox=\"0 0 200 120\" width=\"100%\" height=\"100%\" aria-hidden=\"true\"><rect x=\"20\" y=\"10\" width=\"160\" height=\"100\" rx=\"3\" fill=\"rgba(10,13,20,0.6)\" stroke=\"#7dffce\" stroke-opacity=\"0.4\"></rect><line x1=\"20\" y1=\"28\" x2=\"180\" y2=\"28\" stroke=\"#3a4156\" stroke-dasharray=\"2 3\"></line><circle cx=\"32\" cy=\"19\" r=\"3\" fill=\"#7dffce\"></circle><text x=\"42\" y=\"22\" fill=\"#8089a0\" font-size=\"6\" font-family=\"monospace\">surface · v1</text><rect x=\"32\" y=\"40\" width=\"80\" height=\"6\" fill=\"#7dffce\" opacity=\"0.6\"></rect><rect x=\"32\" y=\"52\" width=\"120\" height=\"4\" fill=\"#3a4156\"></rect><rect x=\"32\" y=\"62\" width=\"100\" height=\"4\" fill=\"#3a4156\"></rect><rect x=\"32\" y=\"72\" width=\"60\" height=\"4\" fill=\"#3a4156\"></rect><rect x=\"32\" y=\"88\" width=\"46\" height=\"14\" rx=\"7\" fill=\"#7dffce\"></rect><text x=\"55\" y=\"97\" fill=\"#05060a\" font-size=\"6\" font-family=\"monospace\" text-anchor=\"middle\">action →</text></svg></div><span class=\"CaseArtifacts_label__Sny3J\">delta explainer · inline</span></div></div></article><article class=\"ArtifactCard_card___XmVC\"><div class=\"ArtifactCard_tag__IQpsb\"><span class=\"ArtifactCard_kind__cjLTf\">RESULT</span><span class=\"ArtifactCard_num__jGVwF\">06</span></div><p class=\"ArtifactCard_caption__LNt5_\">38% reduction in billing-related contact volume in the first six months. Customer-satisfaction (CSAT) on billing up 31 points. The bill became the most-praised surface of the entire BT Business product.</p><div class=\"ArtifactCard_visual__4vrVD\"><div class=\"CaseArtifacts_frame__F_BST\"><div class=\"CaseArtifacts_svg__Gz73o\"><svg viewBox=\"0 0 200 120\" width=\"100%\" height=\"100%\" aria-hidden=\"true\"><text x=\"100\" y=\"62\" fill=\"#7dffce\" font-size=\"44\" font-family=\"Fraunces, Georgia, serif\" font-style=\"italic\" font-weight=\"300\" text-anchor=\"middle\">↓ 38%</text><line x1=\"40\" y1=\"80\" x2=\"160\" y2=\"80\" stroke=\"#7dffce\" stroke-opacity=\"0.4\"></line><text x=\"100\" y=\"94\" fill=\"#8089a0\" font-size=\"7\" font-family=\"monospace\" text-anchor=\"middle\" letter-spacing=\"2\">MEASURED · POST-SHIP</text></svg></div><span class=\"CaseArtifacts_label__Sny3J\">billing support contact</span></div></div></article></div></div></section><div class=\"container\"><blockquote class=\"PullQuote_q__aBMCT\"><span class=\"PullQuote_mark__5kDBG\" aria-hidden=\"true\">&quot;</span><p>A bill is the place where the company is most likely to be hated. Redesign the bill, and you redesign the entire relationship.</p><span class=\"PullQuote_mark__5kDBG PullQuote_markRight__MyOts\" aria-hidden=\"true\">&quot;</span></blockquote></div><section id=\"depth\" class=\"page_depth__CNMEo\"><div class=\"container\"><div class=\"page_layerLabel__jlWsQ\">// layer 03 · depth</div><h2 class=\"page_layerTitle__PsrE5\">The <em>reasoning</em> behind the surface.</h2><div class=\"page_depthGrid__5NSpR\"><article class=\"page_depthItem__jCa7X\"><h3 class=\"page_depthHeading__BcC_0\">The regulatory constraint that became the design</h3><p class=\"page_depthBody__1gDD9\">Ofcom rules looked like a wall — every line item, every taxonomy, every disclosure. The breakthrough came when we stopped treating them as constraints and started treating them as the grammar of the document. Each rule became a section type. The redesign was not &#x27;us versus regulation&#x27;; it was a typesetting problem at scale.</p></article><article class=\"page_depthItem__jCa7X\"><h3 class=\"page_depthHeading__BcC_0\">Why we built the delta explainer</h3><p class=\"page_depthBody__1gDD9\">Six weeks of call-centre transcript analysis showed that 64% of billing calls started with the same sentence: &#x27;why is my bill different this month?&#x27; Instead of redesigning the call experience, we wrote the answer onto the bill. The customer never reaches for the phone. That single feature drove most of the support-volume reduction.</p></article><article class=\"page_depthItem__jCa7X\"><h3 class=\"page_depthHeading__BcC_0\">Designing for trust at consumer scale, not B2B</h3><p class=\"page_depthBody__1gDD9\">BT Business buyers are small business owners — solo accountants, café operators, fitness studios. They are consumers in every emotional sense, even though the contract is B2B. The redesign succeeded because we wrote the copy at year-7 reading level, not corporate-procurement level. Enterprise designers who carry the corporate voice into SMB lose the audience in two sentences.</p></article></div></div></section><div class=\"container\"><section class=\"EndFrame_end__CpCvl\" data-narrate=\"endframe\"><div class=\"EndFrame_col__qn7Xv\"><div class=\"EndFrame_label__tUF6K\">// what this case proves</div><p class=\"EndFrame_proves__UyCFL\">I can lead a consumer-grade redesign of a regulated, mission-critical surface — and reduce operating cost while raising satisfaction.</p></div><div class=\"EndFrame_col__qn7Xv\"><div class=\"EndFrame_label__tUF6K\">// next case</div><a class=\"EndFrame_next__lUtYb\" href=\"/work/panchang-engine\"><span class=\"EndFrame_nextTag__B5uaS\">Consumer · culture</span><span class=\"EndFrame_nextTitle__U7pnM\">Panchang Engine — a calendar that breathes<!-- --> <em class=\"EndFrame_arrow__AV7cw\">→</em></span></a></div><div class=\"EndFrame_col__qn7Xv\"><div class=\"EndFrame_label__tUF6K\">// talk to me about this</div><a class=\"EndFrame_cta__uKpi7\" href=\"/contact\">Book a 30-min call →</a></div></section></div></main><footer class=\"FooterCTA_footer__Ixqe_\" data-narrate=\"footer\"><div class=\"container\"><div class=\"FooterCTA_grid__lUIv3\"><div class=\"FooterCTA_left__6mMWK\"><div class=\"FooterCTA_kicker__bGOAy\">// closing</div><h2 class=\"FooterCTA_title__IVNFn\">You&#x27;ve read this far.<br/><span class=\"serif-italic\">Let&#x27;s talk.</span></h2><p class=\"FooterCTA_sub__SMCHf\">I&#x27;m interviewing for Design Director and AI Product Design Lead roles in 2026. I prefer async-first conversation that gets concrete fast.</p></div><div class=\"FooterCTA_right__b4FDk\"><button class=\"FooterCTA_primary__JPu79\">Book a 30-min call →</button><a class=\"FooterCTA_btn__g__wU\" href=\"#\">Download case deck (PDF)</a><a class=\"FooterCTA_btn__g__wU\" href=\"mailto:ar.anupamsarkar@gmail.com\">ar.anupamsarkar@gmail.com</a><a class=\"FooterCTA_btn__g__wU\" href=\"https://linkedin.com\" target=\"_blank\" rel=\"noreferrer\">LinkedIn ↗</a></div></div><div class=\"FooterCTA_meta__zUBAe\"><span>© 2026 Anupam Sarkar</span><span>built · v0.1 · agent-native</span><span>The agent is the form.</span></div></div></footer><!--$--><!--/$--><aside class=\"AgentStatusRail_rail__PSUPd\" aria-label=\"Agent status — Chitra\" role=\"status\" aria-live=\"polite\"><header class=\"AgentStatusRail_head__ASvL_\"><div class=\"AgentStatusRail_orb__GPfKP AgentStatusRail_idle__FbaNE\" aria-hidden=\"true\"></div><div class=\"AgentStatusRail_title__DnvEW\"><div class=\"AgentStatusRail_name__ib4o6\"><span class=\"serif-italic\">Chitra</span></div><div class=\"AgentStatusRail_meta__rohV9\">agent · v0.1</div></div><div class=\"AgentStatusRail_pill__psDgR AgentStatusRail_idle__FbaNE\">idle</div></header><div class=\"AgentStatusRail_log__yZZ4N\"></div></aside><div class=\"CursorSensor_aura__22Lry\" aria-hidden=\"true\"></div><div class=\"CursorSensor_core__EOtR7\" aria-hidden=\"true\"></div><script 