,\"y2\":\"10\",\"stroke\":\"#ff4d8b\",\"strokeOpacity\":\"0.6\",\"strokeWidth\":\"1\"}],[\"$\",\"text\",null,{\"x\":\"8\",\"y\":\"14\",\"fill\":\"#8089a0\",\"fontSize\":\"7\",\"fontFamily\":\"monospace\",\"children\":[\"alt 0\",2,\" — rejected\"]}]]}],[\"$\",\"g\",\"2\",{\"transform\":\"translate(20, 80)\",\"children\":[[\"$\",\"rect\",null,{\"width\":\"160\",\"height\":\"20\",\"fill\":\"none\",\"stroke\":\"#3a4156\",\"strokeDasharray\":\"2 3\"}],[\"$\",\"line\",null,{\"x1\":\"0\",\"y1\":\"10\",\"x2\":\"160\",\"y2\":\"10\",\"stroke\":\"#ff4d8b\",\"strokeOpacity\":\"0.6\",\"strokeWidth\":\"1\"}],[\"$\",\"text\",null,{\"x\":\"8\",\"y\":\"14\",\"fill\":\"#8089a0\",\"fontSize\":\"7\",\"fontFamily\":\"monospace\",\"children\":[\"alt 0\",3,\" — rejected\"]}]]}]]}]}],[\"$\",\"span\",null,{\"className\":\"CaseArtifacts_label__Sny3J\",\"children\":\"three rejected paths\"}]]}]}]]}],[\"$\",\"article\",\"03\",{\"className\":\"ArtifactCard_card___XmVC\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ArtifactCard_tag__IQpsb\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ArtifactCard_kind__cjLTf\",\"children\":\"CONSTRAINT\"}],[\"$\",\"span\",null,{\"className\":\"ArtifactCard_num__jGVwF\",\"children\":\"03\"}]]}],[\"$\",\"p\",null,{\"className\":\"ArtifactCard_caption__LNt5_\",\"children\":\"UK Ofcom rules dictate what must appear on a B2B bill. The redesign had to honour every regulatory line item — and still feel like a single readable document, not a compliance dump.\"}],\"$L1e\"]}],\"$L1f\",\"$L20\",\"$L21\"]}]\n1a:[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"blockquote\",null,{\"className\":\"PullQuote_q__aBMCT\",\"children\":[[\"$\",\"span\",null,{\"className\":\"PullQuote_mark__5kDBG\",\"aria-hidden\":true,\"children\":\"\\\"\"}],[\"$\",\"p\",null,{\"children\":\"A bill is the place where the company is most likely to be hated. Redesign the bill, and you redesign the entire relationship.\"}],[\"$\",\"span\",null,{\"className\":\"PullQuote_mark__5kDBG PullQuote_markRight__MyOts\",\"aria-hidden\":true,\"children\":\"\\\"\"}]]}]}]\n1b:[\"$\",\"section\",null,{\"id\":\"depth\",\"className\":\"page_depth__CNMEo\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page_layerLabel__jlWsQ\",\"children\":\"// layer 03 · depth\"}],[\"$\",\"h2\",null,{\"className\":\"page_layerTitle__PsrE5\",\"children\":[\"The \",[\"$\",\"em\",null,{\"children\":\"reasoning\"}],\" behind the surface.\"]}],[\"$\",\"div\",null,{\"className\":\"page_depthGrid__5NSpR\",\"children\":[[\"$\",\"article\",\"The regulatory constraint that became the design\",{\"className\":\"page_depthItem__jCa7X\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"page_depthHeading__BcC_0\",\"children\":\"The regulatory constraint that became the design\"}],[\"$\",\"p\",null,{\"className\":\"page_depthBody__1gDD9\",\"children\":\"Ofcom rules looked like a wall — every line item, every taxonomy, every disclosure. The breakthrough came when we stopped treating them as constraints and started treating them as the grammar of the document. Each rule became a section type. The redesign was not 'us versus regulation'; it was a typesetting problem at scale.\"}]]}],[\"$\",\"article\",\"Why we built the delta explainer\",{\"className\":\"page_depthItem__jCa7X\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"page_depthHeading__BcC_0\",\"children\":\"Why we built the delta explainer\"}],[\"$\",\"p\",null,{\"className\":\"page_depthBody__1gDD9\",\"children\":\"Six weeks of call-centre transcript analysis showed that 64% of billing calls started with the same sentence: 'why is my bill different this month?' Instead of redesigning the call experience, we wrote the answer onto the bill. The customer never reaches for the phone. That single feature drove most of the support-volume reduction.\"}]]}],[\"$\",\"article\",\"Designing for trust at consumer scale, not B2B\",{\"className\":\"page_depthItem__jCa7X\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"page_depthHeading__BcC_0\",\"children\":\"Designing for trust at consumer scale, not B2B\"}],[\"$\",\"p\",null,{\"className\":\"page_depthBody__1gDD9\",\"children\":\"BT Business buyers are small business owners — solo accountants, café operators, fitness studios. They are consumers in every emotional sense, even though the contract is B2B. The redesign succeeded because we wrote the copy at year-7 reading level, not corporate-procurement level. Enterprise designers who carry the corporate voice into SMB lose the audience in two sentences.\"}]]}]]}]]}]}]\n1c:[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"section\",null,{\"className\":\"EndFrame_end__CpCvl\",\"data-narrate\":\"endframe\",\"children\":[[\"$\",\"div\",null,{\"className\":\"EndFrame_col__qn7Xv\",\"children\":[[\"$\",\"div\",null,{\"className\":\"EndFrame_label__tUF6K\",\"children\":\"// what this case proves\"}],[\"$\",\"p\",null,{\"className\":\"EndFrame_proves__UyCFL\",\"children\":\"I can lead a consumer-grade redesign of a regulated, mission-critical surface — and reduce operating cost while raising satisfaction.\"}]]}],[\"$\",\"div\",null,{\"className\":\"EndFrame_col__qn7Xv\",\"children\":[[\"$\",\"div\",null,{\"className\":\"EndFrame_label__tUF6K\",\"children\":\"// next case\"}],[\"$\",\"$L7\",null,{\"href\":\"/work/panchang-engine\",\"className\":\"EndFrame_next__lUtYb\",\"children\":[[\"$\",\"span\",null,{\"className\":\"EndFrame_nextTag__B5uaS\",\"children\":\"Consumer · culture\"}],[\"$\",\"span\",null,{\"className\":\"EndFrame_nextTitle__U7pnM\",\"children\":[\"Panchang Engine — a calendar that breathes\",\" \",[\"$\",\"em\",null,{\"className\":\"EndFrame_arrow__AV7cw\",\"children\":\"→\"}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"EndFrame_col__qn7Xv\",\"children\":[[\"$\",\"div\",null,{\"className\":\"EndFrame_label__tUF6K\",\"children\":\"// talk to me about this\"}],[\"$\",\"$L7\",null,{\"href\":\"/cont