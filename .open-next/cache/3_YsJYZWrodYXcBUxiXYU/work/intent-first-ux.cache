"line\",null,{\"x1\":\"0\",\"y1\":\"10\",\"x2\":\"160\",\"y2\":\"10\",\"stroke\":\"#ff4d8b\",\"strokeOpacity\":\"0.6\",\"strokeWidth\":\"1\"}],[\"$\",\"text\",null,{\"x\":\"8\",\"y\":\"14\",\"fill\":\"#8089a0\",\"fontSize\":\"7\",\"fontFamily\":\"monospace\",\"children\":[\"alt 0\",3,\" — rejected\"]}]]}]]}]}],[\"$\",\"span\",null,{\"className\":\"CaseArtifacts_label__Sny3J\",\"children\":\"three rejected models\"}]]}]}]]}],[\"$\",\"article\",\"03\",{\"className\":\"ArtifactCard_card___XmVC\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ArtifactCard_tag__IQpsb\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ArtifactCard_kind__cjLTf\",\"children\":\"CONSTRAINT\"}],[\"$\",\"span\",null,{\"className\":\"ArtifactCard_num__jGVwF\",\"children\":\"03\"}]]}],[\"$\",\"p\",null,{\"className\":\"ArtifactCard_caption__LNt5_\",\"children\":\"Frameworks rot. Mine had to be short enough to memorise, generative enough to redraw, and embarrassing enough to be obviously incomplete if I added a fifth stage.\"}],\"$L1e\"]}],\"$L1f\",\"$L20\",\"$L21\"]}]\n1a:[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"blockquote\",null,{\"className\":\"PullQuote_q__aBMCT\",\"children\":[[\"$\",\"span\",null,{\"className\":\"PullQuote_mark__5kDBG\",\"aria-hidden\":true,\"children\":\"\\\"\"}],[\"$\",\"p\",null,{\"children\":\"A framework that requires me to be in the room is not a framework. It is a consulting engagement with delusions.\"}],[\"$\",\"span\",null,{\"className\":\"PullQuote_mark__5kDBG PullQuote_markRight__MyOts\",\"aria-hidden\":true,\"children\":\"\\\"\"}]]}]}]\n1b:[\"$\",\"section\",null,{\"id\":\"depth\",\"className\":\"page_depth__CNMEo\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page_layerLabel__jlWsQ\",\"children\":\"// layer 03 · depth\"}],[\"$\",\"h2\",null,{\"className\":\"page_layerTitle__PsrE5\",\"children\":[\"The \",[\"$\",\"em\",null,{\"children\":\"reasoning\"}],\" behind the surface.\"]}],[\"$\",\"div\",null,{\"className\":\"page_depthGrid__5NSpR\",\"children\":[[\"$\",\"article\",\"Why every AI product fails the Sense stage first\",{\"className\":\"page_depthItem__jCa7X\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"page_depthHeading__BcC_0\",\"children\":\"Why every AI product fails the Sense stage first\"}],[\"$\",\"p\",null,{\"className\":\"page_depthBody__1gDD9\",\"children\":\"Most AI products skip Sense — they assume the user has already typed enough. Sense is the moment the interface decides what kind of intelligence is needed. Get this wrong and the rest of the loop is loud activity in the wrong direction. The fix is almost always: surface less, ask one shaped question, and wait.\"}]]}],[\"$\",\"article\",\"Morph is where designers panic\",{\"className\":\"page_depthItem__jCa7X\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"page_depthHeading__BcC_0\",\"children\":\"Morph is where designers panic\"}],[\"$\",\"p\",null,{\"className\":\"page_depthBody__1gDD9\",\"children\":\"Morph is the visible reshaping of the interface to match what was sensed. Designers panic here because it breaks the contract that 'the UI stays still.' But that contract was always a lie — the UI was reshaping you. Morph just makes it honest. The rule: morph slowly enough that the user can see what changed, fast enough that they don't think it broke.\"}]]}],[\"$\",\"article\",\"Escape is the stage no one builds\",{\"className\":\"page_depthItem__jCa7X\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"page_depthHeading__BcC_0\",\"children\":\"Escape is the stage no one builds\"}],[\"$\",\"p\",null,{\"className\":\"page_depthBody__1gDD9\",\"children\":\"Confirm gets attention because it's where the action fires. But Escape — the ability to back out of the loop, undo the morph, return to ambient state — is what makes an agent trustworthy. Build Escape first; it is the only stage that retroactively pays for the other three.\"}]]}]]}]]}]}]\n1