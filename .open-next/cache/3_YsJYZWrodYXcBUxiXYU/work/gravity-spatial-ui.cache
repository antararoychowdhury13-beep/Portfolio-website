\",\"span\",null,{\"className\":\"ArtifactCard_num__jGVwF\",\"children\":\"02\"}]]}],[\"$\",\"p\",null,{\"className\":\"ArtifactCard_caption__LNt5_\",\"children\":\"Three alternatives I rejected: a layered Z-axis model, a 'volumetric Material Design,' and a pure gaze-based system. Each one preserved the rectangle. GRAVITY removes it.\"}],[\"$\",\"div\",null,{\"className\":\"ArtifactCard_visual__4vrVD\",\"children\":[\"$\",\"div\",null,{\"className\":\"CaseArtifacts_frame__F_BST\",\"children\":[[\"$\",\"div\",null,{\"className\":\"CaseArtifacts_svg__Gz73o\",\"children\":[\"$\",\"svg\",null,{\"viewBox\":\"0 0 200 120\",\"width\":\"100%\",\"height\":\"100%\",\"aria-hidden\":true,\"children\":[[\"$\",\"g\",\"0\",{\"transform\":\"translate(20, 20)\",\"children\":[[\"$\",\"rect\",null,{\"width\":\"160\",\"height\":\"20\",\"fill\":\"none\",\"stroke\":\"#3a4156\",\"strokeDasharray\":\"2 3\"}],[\"$\",\"line\",null,{\"x1\":\"0\",\"y1\":\"10\",\"x2\":\"160\",\"y2\":\"10\",\"stroke\":\"#ff4d8b\",\"strokeOpacity\":\"0.6\",\"strokeWidth\":\"1\"}],[\"$\",\"text\",null,{\"x\":\"8\",\"y\":\"14\",\"fill\":\"#8089a0\",\"fontSize\":\"7\",\"fontFamily\":\"monospace\",\"children\":[\"alt 0\",1,\" — rejected\"]}]]}],[\"$\",\"g\",\"1\",{\"transform\":\"translate(20, 50)\",\"children\":[[\"$\",\"rect\",null,{\"width\":\"160\",\"height\":\"20\",\"fill\":\"none\",\"stroke\":\"#3a4156\",\"strokeDasharray\":\"2 3\"}],[\"$\",\"line\",null,{\"x1\":\"0\",\"y1\":\"10\",\"x2\":\"160\",\"y2\":\"10\",\"stroke\":\"#ff4d8b\",\"strokeOpacity\":\"0.6\",\"strokeWidth\":\"1\"}],[\"$\",\"text\",null,{\"x\":\"8\",\"y\":\"14\",\"fill\":\"#8089a0\",\"fontSize\":\"7\",\"fontFamily\":\"monospace\",\"children\":[\"alt 0\",2,\" — rejected\"]}]]}],[\"$\",\"g\",\"2\",{\"transform\":\"translate(20, 80)\",\"children\":[[\"$\",\"rect\",null,{\"width\":\"160\",\"height\":\"20\",\"fill\":\"none\",\"stroke\":\"#3a4156\",\"strokeDasharray\":\"2 3\"}],[\"$\",\"line\",null,{\"x1\":\"0\",\"y1\":\"10\",\"x2\":\"160\",\"y2\":\"10\",\"stroke\":\"#ff4d8b\",\"strokeOpacity\":\"0.6\",\"strokeWidth\":\"1\"}],[\"$\",\"text\",null,{\"x\":\"8\",\"y\":\"14\",\"fill\":\"#8089a0\",\"fontSize\":\"7\",\"fontFamily\":\"monospace\",\"children\":[\"alt 0\",3,\" — rejected\"]}]]}]]}]}],[\"$\",\"span\",null,{\"className\":\"CaseArtifacts_label__Sny3J\",\"children\":\"three rejected spatial models\"}]]}]}]]}],[\"$\",\"article\",\"03\",{\"className\":\"ArtifactCard_card___XmVC\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ArtifactCard_tag__IQpsb\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ArtifactCard_kind__cjLTf\",\"children\":\"CONSTRAINT\"}],[\"$\",\"span\",null,{\"className\":\"ArtifactCard_num__jGVwF\",\"children\":\"03\"}]]}],[\"$\",\"p\",null,{\"className\":\"ArtifactCard_caption__LNt5_\",\"children\":\"Spatial UI design at this stage of the industry has zero shared vocabulary. The framework had to be teachable to a developer in 90 seconds — or it would die in the docs.\"}],\"$L1f\"]}],\"$L20\",\"$L21\",\"$L22\"]}]\n1b:[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"blockquote\",null,{\"className\":\"PullQuote_q__aBMCT\",\"children\":[[\"$\",\"span\",null,{\"className\":\"PullQuote_mark__5kDBG\",\"aria-hidden\":true,\"children\":\"\\\"\"}],[\"$\",\"p\",null,{\"children\":\"An agent that lives in a window is a chatbot wearing a hat. Spatial computing only matters if the agent can live somewhere the window cannot.\"}],[\"$\",\"span\",null,{\"className\":\"PullQuote_mark__5kDBG PullQuote_markRight__MyOts\",\"aria-hidden\":true,\"children\":\"\\\"\"}]]}]}]\n1c:[\"$\",\"section\",null,{\"id\":\"depth\",\"className\":\"page_depth__CNMEo\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page_layerLabel__jlWsQ\",\"children\":\"// layer 03 · depth\"}],[\"$\",\"h2\",null,{\"className\":\"page_layerTitle__PsrE5\",\"children\":[\"The \",[\"$\",\"em\",null,{\"children\":\"reasoning\"}],\" behind the surface.\"]}],[\"$\",\"div\",null,{\"className\":\"page_depthGrid__5NSpR\",\"children\":[[\"$\",\"article\",\"Why the Ring plane is the most contested\",{\"className\":\"page_depthItem__jCa7X\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"page_depthHeading__BcC_0\",\"children\":\"Why the Ring plane is the most contested\"}],[\"$\",\"p\",null,{\"className\":\"page_depthBody__1gDD9\",\"children\":\"Ring is where the user reaches with their hand — roughly 30 to 60 cm from the head. It is the most contested plane because every product team wants to put everything there. The discipline is the opposite: Ring is for the one thing the user is acting on right now, and nothing else. Anything that doesn't earn Ring belongs in Atmosphere.\"}]]}],[\"$\",\"article\",\"Voice is a plane, not a modality\",{\"className\":\"page_depthItem__jCa7X\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"page_depthHeading__BcC_0\",\"children\":\"Voice is a plane, not a modality\"}],[\"$\",\"p\",null,{\"className\":\"page_depthBody__1gDD9\",\"children\":\"The mistake everyone makes is treating voice as a competing modality to touch. In GRAVITY, Voice is a plane — it has spatial properties, decay, directionality, a trust radius. Treat voice as a plane and the question 'should this be voice or visual?' dissolves into 'which plane is the right home for this action?'\"}]]}],[\"$\",\"article\",\"The framework's deliberate omission\",{\"className\":\"page_depthItem__jCa7X\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"page_depthHeading__BcC_0\",\"children\":\"The framework's deliberate omission\"}],[\"$\",\"p\",null,{\"className\":\"page_depthBody__1gDD9\",\"children\":\"GRAVITY does not have a fifth plane for time, or for memory, or for social presence. I have been asked to add each one and have refused each time. Frameworks die from completeness, not from gaps. Four is the maximum a designer can hold in working memory while sketching.\"}]]}]]}]]}]}]\n1d:[\"$\",\"div\",null,{\"className\":\"container