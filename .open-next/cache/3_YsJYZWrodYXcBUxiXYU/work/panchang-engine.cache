height\":\"20\",\"fill\":\"none\",\"stroke\":\"#3a4156\",\"strokeDasharray\":\"2 3\"}],[\"$\",\"line\",null,{\"x1\":\"0\",\"y1\":\"10\",\"x2\":\"160\",\"y2\":\"10\",\"stroke\":\"#ff4d8b\",\"strokeOpacity\":\"0.6\",\"strokeWidth\":\"1\"}],[\"$\",\"text\",null,{\"x\":\"8\",\"y\":\"14\",\"fill\":\"#8089a0\",\"fontSize\":\"7\",\"fontFamily\":\"monospace\",\"children\":[\"alt 0\",3,\" — rejected\"]}]]}]]}]}],[\"$\",\"span\",null,{\"className\":\"CaseArtifacts_label__Sny3J\",\"children\":\"three rejected calendars\"}]]}]}]]}],[\"$\",\"article\",\"03\",{\"className\":\"ArtifactCard_card___XmVC\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ArtifactCard_tag__IQpsb\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ArtifactCard_kind__cjLTf\",\"children\":\"CONSTRAINT\"}],[\"$\",\"span\",null,{\"className\":\"ArtifactCard_num__jGVwF\",\"children\":\"03\"}]]}],[\"$\",\"p\",null,{\"className\":\"ArtifactCard_caption__LNt5_\",\"children\":\"Different lineages compute the same event on different days. The system had to model the disagreement — not flatten it — and let the user pick a lineage without judgement.\"}],\"$L1e\"]}],\"$L1f\",\"$L20\",\"$L21\"]}]\n1a:[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"blockquote\",null,{\"className\":\"PullQuote_q__aBMCT\",\"children\":[[\"$\",\"span\",null,{\"className\":\"PullQuote_mark__5kDBG\",\"aria-hidden\":true,\"children\":\"\\\"\"}],[\"$\",\"p\",null,{\"children\":\"Most calendar apps are storage. The Panchang Engine is intention — it answers the question 'what should I be doing today?' before the user is awake enough to ask.\"}],[\"$\",\"span\",null,{\"className\":\"PullQuote_mark__5kDBG PullQuote_markRight__MyOts\",\"aria-hidden\":true,\"children\":\"\\\"\"}]]}]}]\n1b:[\"$\",\"section\",null,{\"id\":\"depth\",\"className\":\"page_depth__CNMEo\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page_layerLabel__jlWsQ\",\"children\":\"// layer 03 · depth\"}],[\"$\",\"h2\",null,{\"className\":\"page_layerTitle__PsrE5\",\"children\":[\"The \",[\"$\",\"em\",null,{\"children\":\"reasoning\"}],\" behind the surface.\"]}],[\"$\",\"div\",null,{\"className\":\"page_depthGrid__5NSpR\",\"children\":[[\"$\",\"article\",\"Astronomy is the easy half\",{\"className\":\"page_depthItem__jCa7X\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"page_depthHeading__BcC_0\",\"children\":\"Astronomy is the easy half\"}],[\"$\",\"p\",null,{\"className\":\"page_depthBody__1gDD9\",\"children\":\"Computing planetary positions for the next ten thousand years is a solved problem; the open-source kernels are battle-tested. The hard half is the tradition layer — encoding the rules that turn raw astronomy into a ritual event. We treated tradition as data, not as content, and the system held.\"}]]}],[\"$\",\"article\",\"Why we modelled disagreement instead of choosing a winner\",{\"className\":\"page_depthItem__jCa7X\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"page_depthHeading__BcC_0\",\"children\":\"Why we modelled disagreement instead of choosing a winner\"}],[\"$\",\"p\",null,{\"className\":\"page_depthBody__1gDD9\",\"children\":\"There are at least three major Panchang lineages in active use, and they disagree on dates several times a year. Building the system around 'the correct' Panchang would have lost half our potential users. We let lineage be a setting. Designers underestimate how much culture lives in the toggles you choose to expose.\"}]]}],[\"$\",\"article\",\"The breathing tile, and why micro-animation is craft\",{\"className\":\"page_depthItem__jCa7X\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"page_depthHeading__BcC_0\",\"children\":\"The breathing tile, and why micro-animation is craft\"}],[\"$\",\"p\",null,{\"className\":\"page_depthBody__1gDD9\",\"children\":\"The Panchang tile breathes — a 4-second loop that swells the gradient by 6%. It is invisible until you've used the app for a week, at which point the still-tile of a day with no observance becomes uncomfortable in the way a held breath does. That is what craft looks like at consumer scale: an animation that earns its place by becoming part of the ritual it represents.\"}]]}]]}]]}]}]\n1c:[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"section\",null,{\"className\":\"EndFrame_end__CpCvl\",\"data-narrate\":\"endframe\",\"children\":[[\"$\",\"div\",null,{\"className\":\"EndFrame_col__qn7Xv\",\"children\":[[\"$\",\"div\",null,{\"className\":\"EndFrame_label__tUF6K\",\"children\":\"// what this case proves\"}],[\"$\",\"p\",null,{\"className\":\"EndFrame_proves__UyCFL\",\"children\":\"I design generative systems that the rest of the team — and the rest of the ecosystem — quietly comes to depend on.\"}]]}],[\"$\",\"div\",null,{\"className\":\"EndFrame_col__qn7Xv\",\"children\":[[\"$\",\"div\",null,{\"className\":\"EndFrame_label__tUF6K\",\"children\":\"// next case\"}],[\"$\",\"$L7\",null,{\"href\":\"/work/dfd-divya\",\"className\":\"EndFrame_next__lUtYb\",\"children\":[[\"$\",\"span\",null,{\"className\":\"EndFrame_nextTag__B5uaS\",\"children\":\"AI-native · agent\"}],[\"$\",\"span\",null,{\"className\":\"EndFrame_nextTitle__U7pnM\",\"children\":[\"Divya — an interface that observes\",\" \",[\"$\",\"em\",null,{\"className\":\"EndFrame_arrow__AV7cw\",\"children\":\"→\"}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"EndFrame_col__qn7Xv\",\"children\":[[\"$\",\"div\",null,{\"className\":\"EndFrame_label__tUF6K\",\"children\":\"// talk to me about this\"}],[\"$\",\"$L7\",null,{\"href\":\"/contact\",\"className\":\"EndFrame_cta__uKpi7\",\"children\":\"Book a 30-min call →\"}]]}]]}]}]\n1d:[\"$\",\"$L22\",null,{}]\n1e:[\"$\",\"div\",null,{\"className\":\"ArtifactCard_visual__4vrVD\",\"children\":[\"$\",\"div\",null,{\"className\":\"CaseArtifacts_frame__F_BST\",\"children\":[[\"$\",\"div\",null,{\"className\":\"CaseArtifacts_svg__Gz73o\",\"children\":[\"$\",\"svg\",null,{\"viewBox\":\"0 0 200